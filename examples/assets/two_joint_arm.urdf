<?xml version="1.0"?>
<!-- Original teaching asset, Apache-2.0; not a calibrated physical robot. -->
<robot name="atlas_two_joint_arm">
  <link name="base">
    <inertial><origin xyz="0 0 0.15"/><mass value="1"/>
      <inertia ixx="0.0078" ixy="0" ixz="0" iyy="0.0078" iyz="0" izz="0.0006"/>
    </inertial>
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.06 0.06 0.30"/></geometry></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><box size="0.06 0.06 0.30"/></geometry></collision>
  </link>
  <link name="upper_arm">
    <inertial><origin xyz="0.125 0 0"/><mass value="0.4"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.002113333333333" iyz="0" izz="0.002113333333333"/>
    </inertial>
    <visual><origin xyz="0.125 0 0"/><geometry><box size="0.25 0.03 0.03"/></geometry></visual>
    <collision><origin xyz="0.125 0 0"/><geometry><box size="0.25 0.03 0.03"/></geometry></collision>
  </link>
  <link name="forearm">
    <inertial><origin xyz="0.10 0 0"/><mass value="0.3"/>
      <inertia ixx="0.00003125" ixy="0" ixz="0" iyy="0.001015625" iyz="0" izz="0.001015625"/>
    </inertial>
    <visual><origin xyz="0.10 0 0"/><geometry><box size="0.20 0.025 0.025"/></geometry></visual>
    <collision><origin xyz="0.10 0 0"/><geometry><box size="0.20 0.025 0.025"/></geometry></collision>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="upper_arm"/><origin xyz="0 0 0.30"/>
    <axis xyz="0 0 1"/><limit lower="-2.5" upper="2.5" effort="3" velocity="2"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/><origin xyz="0.25 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-2.5" upper="2.5" effort="3" velocity="2"/>
  </joint>
</robot>
